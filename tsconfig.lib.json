{
  // The shipped sources alone, under the oldest lib a consumer compiles them
  // with (loom: ES2020) and no ambient types: the root config's test types
  // (vitest, node) bring newer lib typings along, which let 0.1.7 ship an
  // ES2022 call (Object.hasOwn) that broke loom's build. Referenced from the
  // root tsconfig, so `tsc -b` (npm run build, the gate) checks it.
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/lib"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
