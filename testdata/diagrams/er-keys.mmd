erDiagram
  CATALOG ||--o{ PRODUCT : contains
  PRODUCT ||--|{ VARIANT : "is split into"
  VARIANT }o..o| IMAGE : "reuses by hash"
  CATALOG {
    int id PK
    string name "unique, never trimmed"
    string last_import
  }
  PRODUCT {
    int id PK
    int catalog_id FK
    string sku
  }
  VARIANT {
    int id PK
    int product_id FK
    string image_hash
  }
  IMAGE {
    string hash PK
    blob pixels
  }
