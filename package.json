{
  "name": "@trick77/diagram",
  "version": "0.0.0",
  "description": "Diagrams laid out and drawn in the browser as SVG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trick77/diagram.git"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mermaid": "./src/mermaid/index.ts",
    "./check": "./src/check/index.ts",
    "./react": "./src/react/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0 && npm run format:check",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' '*.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' '*.ts'",
    "test": "vitest run"
  },
  "dependencies": {
    "elkjs": "0.12.1"
  },
  "peerDependencies": {
    "mermaid": "^12.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "mermaid": "12.3.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
